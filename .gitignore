# Editors / OS
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Scratch and logs
/tmp/
*.log
*.bak
*.orig

# Secrets: never commit keys, tokens or env files
.env
.env.*
!.env.example
id_*
!id_*.pub.example
*.pem
*.key
*.p12
*.pfx
*.gpg
!config/**/*.gpg.example
.ssh/
known_hosts
*.kdbx

# fluxion scratch output (plans, snapshots, imports written into the repo by hand)
/snapshot*.json
/plan*.json
/import-*.yaml

# Test harness output: generated test profiles (derived from profiles/, regenerated before every use by
# tests/gen-test-profiles.sh) and run logs.
/tests/generated/
/tests/logs/
__pycache__/

# Machine-local pointer to the fluxion build to run (scripts/lib/fluxion-bin.sh, `just use-fluxion PATH`)
/fluxion-bin.local
