# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 4
# matches the old repo's `shfmt -i 4 -ci -bn`
shell_variant = bash
switch_case_indent = true
binary_next_line = true

[{.zshrc,.bashrc,.profile}]
indent_size = 4

[{Justfile,justfile,*.just}]
indent_size = 4

[*.lua]
indent_size = 2

[*.{toml,kdl}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
